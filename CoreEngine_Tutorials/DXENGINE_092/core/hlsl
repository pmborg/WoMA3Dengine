    {
        float4 fog4 = 0;

        fog4.r = (1.0 - input.fogFactor);
        fog4.g = fog4.r;
        fog4.b = fog4.r;
        textureColor.rgb = lerp(textureColor.rgb, fogColor.rgb, fog4.rgb);
    }
#endif
    
    //return float4(0, 1, 1, 1);
    //textureColor.a = 1;
	return textureColor;
}
