#version 300 es
precision mediump float;

/////////////////////
// INPUT VARIABLES //
/////////////////////
in vec3 color;

//////////////////////
// OUTPUT VARIABLES //
//////////////////////
out vec4 outputColor;

////////////////////////////////////////////////////////////////////////////////
// Pixel Shader
////////////////////////////////////////////////////////////////////////////////
void main(void)
{
	//vec3 c = vec3(1, 0, 0);
	//outputColor = vec4(c, 1.0f);
	outputColor = vec4(color, 1.0f);
} 